APP_NAME="Zad Academy API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.zadacademiq.com
APP_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zad_prod
DB_USERNAME=zad
DB_PASSWORD=

# ── Sessions & Cache ─────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.zadacademiq.com

CACHE_STORE=file
QUEUE_CONNECTION=database

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://zadacademiq.com,https://www.zadacademiq.com,https://staging.zadacademiq.com

# ── Sanctum ──────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=zadacademiq.com,www.zadacademiq.com,staging.zadacademiq.com

# ── Mail (Resend) ─────────────────────────────────────────────
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="info@zadacademiq.com"
MAIL_FROM_NAME="Zad Academy"

ADMIN_NOTIFICATION_EMAIL=info@zadacademiq.com

# ── Next.js ISR revalidation ──────────────────────────────────
NEXT_REVALIDATE_URL=https://zadacademiq.com/api/revalidate
NEXT_REVALIDATE_SECRET=

# ── hCaptcha (Sprint 4) ───────────────────────────────────────
HCAPTCHA_SECRET=

# ── Sentry ────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=

# ── AWS / Backblaze B2 (Sprint 7 backups) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
